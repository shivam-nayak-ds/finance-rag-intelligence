# Environment & Secrets
.env
*.key

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual Environment
.venv/
venv/
env/

# Data — raw PDFs and binary databases
*.pdf
data/processed/
data/vectorstore/
data/syllaiq.db
data/evaluation/results/

# ChromaDB persistent store
data/vectorstore/chroma/

# BM25 index (binary)
*.pkl

# Notebooks checkpoints
.ipynb_checkpoints/

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker
docker/data/

# Evaluation results (generated, not committed)
data/evaluation/results/
