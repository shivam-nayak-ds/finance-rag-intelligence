# =============================================================
# SyllAIq — Environment Variables
# AI-Powered Exam Preparation for RGPV
# =============================================================
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to git.

# ─────────────────────────────────────────────────────────────
# LLM Providers
# ─────────────────────────────────────────────────────────────

# Groq (Primary LLM — free tier available)
# Get key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (Fallback LLM — free tier available)
# Get key: https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# ─────────────────────────────────────────────────────────────
# Reranking
# ─────────────────────────────────────────────────────────────

# Cohere (Reranker — free tier: 1000 req/month)
# Get key: https://dashboard.cohere.com
COHERE_API_KEY=your_cohere_api_key_here

# ─────────────────────────────────────────────────────────────
# Web Search (Phase 11 — leave blank for now)
# ─────────────────────────────────────────────────────────────

# Tavily (Recommended for agentic web search)
# Get key: https://app.tavily.com
TAVILY_API_KEY=

# ─────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
